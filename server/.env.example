# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB connection string (local or Atlas)
MONGO_URI=

# Any long random text, used to sign login cookies
SESSION_SECRET=

PORT=5000

# The address of the website (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Google Calendar sync (optional: without these, the Google Calendar card stays hidden)
# Create them in the Google Cloud console: APIs & Services > Credentials > OAuth client ID (Web application),
# with this redirect URI: http://localhost:5000/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback
